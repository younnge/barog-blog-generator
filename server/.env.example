# 로컬 테스트용 환경변수 견본.
# 이 파일을 복사해 server/.env 로 만들고 값을 채운다. (.env 는 저장소에 올라가지 않는다)
# 실제 운영 값은 Render 대시보드 환경변수에만 넣는다.

# 팀이 함께 쓰는 공통 비밀번호
APP_PASSWORD=test1234

# 토큰 서명키 — 아무 긴 랜덤 문자열
SESSION_SECRET=local-test-secret-change-me

# 화면이 배포될 주소 (쉼표로 여러 개 가능)
ALLOWED_ORIGINS=https://younnge.github.io

# Claude API 키 — https://console.anthropic.com 에서 발급
# 이 키는 서버에만 존재한다. 프론트 코드·번들·응답 어디에도 넣지 않는다.
ANTHROPIC_API_KEY=sk-ant-...

# 모델 (비워두면 아래 기본값을 쓴다)
# MODEL_FAST=claude-haiku-4-5
# MODEL_MAIN=claude-sonnet-5
